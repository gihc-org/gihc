---
layout: base.njk
---
{% from "activity-icon.njk" import icon %}
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="eyebrow-badge">{{ site.hero.eyebrowBadge }}</span>
        <span class="eyebrow-note">{{ site.hero.eyebrowNote }}</span>
      </p>
      <h1 id="hero-title">
        {% for line in site.hero.titleLines %}
          <span{% if line.className %} class="{{ line.className }}"{% endif %}>{{ line.text }}</span>
        {% endfor %}
      </h1>
      <p class="hero-intro">{{ site.hero.intro }}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="{{ site.hero.primaryAction.href }}">
          {{ site.hero.primaryAction.label }}
          <span aria-hidden="true">{{ site.hero.primaryAction.icon }}</span>
        </a>
        <a class="text-link" href="{{ site.hero.secondaryAction.href }}">{{ site.hero.secondaryAction.label }} <span aria-hidden="true">{{ site.hero.secondaryAction.icon }}</span></a>
      </div>
      <ul class="hero-facts" aria-label="Kort om GIHC">
        {% for fact in site.hero.facts %}<li>{{ fact }}</li>{% endfor %}
      </ul>
    </div>

    <div class="hero-poster" aria-hidden="true">
      <span class="poster-note poster-note-top">{{ site.hero.poster.note }}</span>
      <span class="poster-cross poster-cross-left">+</span>
      <span class="poster-cross poster-cross-right">+</span>
      <img class="poster-emblem" src="{{ site.brand.logo }}" width="1254" height="1254" alt="" decoding="async">
      <div class="poster-legend">
        {% for item in site.hero.poster.legend %}<span>{{ item }}</span>{% endfor %}
      </div>
      <span class="poster-coordinate">{{ site.hero.poster.coordinate }}</span>
    </div>
  </section>

  <section class="principles" aria-label="Vores udgangspunkt">
    {% for principle in site.principles %}
      <article>
        <span class="principle-number">{{ principle.number }}</span>
        <h2>{{ principle.title }}</h2>
        <p>{{ principle.text }}</p>
      </article>
    {% endfor %}
  </section>

  <section class="scenarios" id="det-naestvaerste" aria-labelledby="scenarios-title">
    <div class="section-heading section-heading-dark">
      <p class="section-index">{{ site.scenarios.index }}</p>
      <h2 id="scenarios-title">{{ site.scenarios.heading.before }} <em>{{ site.scenarios.heading.emphasis }}</em></h2>
      <p>{{ site.scenarios.intro }}</p>
    </div>
    <div class="scenario-grid">
      {% for card in site.scenarios.cards %}
        <article class="scenario-card">
          <p class="scenario-time"><span>{{ card.time }}</span><span>{{ card.number }}</span></p>
          <h3>{{ card.title }}</h3>
          <p>{{ card.text }}</p>
          <div class="scenario-tags">
            {% for tag in card.tags %}<span>{{ tag }}</span>{% endfor %}
          </div>
        </article>
      {% endfor %}
    </div>
    <p class="scenarios-note"><span aria-hidden="true">✳</span>{{ site.scenarios.note }}</p>
  </section>

  <section class="activities" id="aktiviteter" aria-labelledby="activities-title">
    <div class="section-heading">
      <p class="section-index">{{ site.activities.index }}</p>
      <h2 id="activities-title">{{ site.activities.heading.before }} <em>{{ site.activities.heading.emphasis }}</em> {{ site.activities.heading.after }}</h2>
      <p>{{ site.activities.intro }}</p>
    </div>
    <div class="activity-grid">
      {% for activity in site.activities.cards %}
        <article class="activity-card {{ activity.className }}">
          <div class="activity-topline">
            <span>{{ activity.format }}</span>
            {{ icon(activity.icon) }}
          </div>
          <h3>{{ activity.title }}</h3>
          <p>{{ activity.text }}</p>
          <p class="activity-detail">{{ activity.detail }}</p>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="hybrid" id="hybrid" aria-labelledby="hybrid-title">
    <div class="section-heading section-heading-dark">
      <p class="section-index">{{ site.hybrid.index }}</p>
      <h2 id="hybrid-title">{{ site.hybrid.heading.before }} <em>{{ site.hybrid.heading.emphasis }}</em></h2>
      <p>{{ site.hybrid.intro }}</p>
    </div>
    <div class="hybrid-pairs" role="list" aria-label="Fire forbindelser">
      {% for pair in site.hybrid.pairs %}
        <article role="listitem">
          <span>{{ pair.left }}</span>
          <strong aria-hidden="true">×</strong>
          <span>{{ pair.right }}</span>
        </article>
      {% endfor %}
    </div>
    <div class="hybrid-quote">
      <span aria-hidden="true">“</span>
      <blockquote>{{ site.hybrid.quote }}</blockquote>
    </div>
  </section>

  <section class="join" id="vaer-med" aria-labelledby="join-title">
    <div class="join-heading">
      <p class="section-index">{{ site.join.index }}</p>
      <h2 id="join-title">{{ site.join.heading.before }} <em>{{ site.join.heading.emphasis }}</em></h2>
    </div>
    <div class="join-copy">
      <p class="join-lead">{{ site.join.lead }}</p>
      <ul>
        {% for point in site.join.points %}
          <li><span>{{ point.label }}</span> {{ point.text }}</li>
        {% endfor %}
      </ul>
      <div class="join-actions">
        <a class="button button-dark" href="{{ site.join.github.href }}">
          {{ site.join.github.label }}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="download-card" href="{{ site.join.download.url }}" download="{{ site.join.download.filename }}" type="application/zip">
          <span class="download-icon" aria-hidden="true">↓</span>
          <span class="download-copy">
            <span class="download-kicker">{{ site.join.download.kicker }}</span>
            <strong>{{ site.join.download.title }}</strong>
            <span class="download-meta">{{ site.join.download.meta }}</span>
          </span>
          <span class="download-arrow" aria-hidden="true">↘</span>
        </a>
        <address class="contact-card" aria-labelledby="contact-title">
          <span class="contact-kicker">{{ site.join.contact.kicker }}</span>
          <strong id="contact-title">{{ site.join.contact.title }}</strong>
          <div class="contact-links">
            <a href="{{ site.join.contact.emailHref }}"><span>{{ site.join.contact.emailLabel }}</span>{{ site.join.contact.email }}</a>
            <a href="{{ site.join.contact.phoneHref }}"><span>{{ site.join.contact.phoneLabel }}</span>{{ site.join.contact.phone }}</a>
          </div>
        </address>
      </div>
    </div>
  </section>

  <section class="manifesto" aria-labelledby="manifesto-title">
    <p class="section-index">{{ site.manifesto.index }}</p>
    <h2 id="manifesto-title">{{ site.manifesto.heading.before }} <em>{{ site.manifesto.heading.emphasis }}</em></h2>
    <div class="manifesto-columns">
      {% for column in site.manifesto.columns %}
        <div>
          <h3>{{ column.title }}</h3>
          <ul>{% for item in column.items %}<li>{{ item }}</li>{% endfor %}</ul>
        </div>
      {% endfor %}
      <div class="manifesto-stamp" aria-label="{{ site.manifesto.stamp[0] }}, {{ site.manifesto.stamp[1] }}, {{ site.manifesto.stamp[2] }}">
        <span>{{ site.manifesto.stamp[0] }}</span>
        <span>{{ site.manifesto.stamp[1] }}</span>
        <strong>{{ site.manifesto.stamp[2] }}</strong>
      </div>
    </div>
  </section>
</main>

